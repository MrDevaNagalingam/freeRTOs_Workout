#include "stm32f4xx.h"
#include "FreeRTOS.h"
#include "task.h"
#include <string.h>
#include <stdio.h>

/* ==================== UART helpers ==================== */
static inline void usart_write_str(USART_TypeDef *U, const char *s) {
    while (*s) {
        while (!(U->SR & USART_SR_TXE));  // wait for TX buffer empty
        U->DR = (uint16_t)(*s++);
    }
    while (!(U->SR & USART_SR_TC));       // wait for transmission complete
}

int _write(int file, char *ptr, int len) {
	(void) file;
	int DataIdx;

	for (DataIdx = 0; DataIdx < len; DataIdx++) {
		ITM_SendChar(*ptr++);
	}
	return len;
}

/* ==================== Globals ==================== */
#define RX_BUFFER_SIZE 64
static volatile char    rxBuffer[RX_BUFFER_SIZE];
static volatile uint8_t rxIndex = 0;
static volatile char    rxByte;

static volatile uint32_t ic_val1=0, ic_val2=0, ic_diff=0;
static volatile uint8_t  ic_first = 0;
static volatile float    g_distance_cm = 0.0f;

/* ==================== Prototypes ==================== */
static void clock_init_84MHz(void);
static void gpio_init(void);
static void usart1_init_9600(void);
static void usart2_init_115200(void);
static void tim2_ic_init(void);

static void hc_sr04_trigger(void);
static float hc_sr04_read_cm(void);
static void process_cmd(const char *cmd);

/* ==================== FreeRTOS tasks ==================== */
static void UltrasonicTask(void *arg);
static void BluetoothTask(void *arg);

/* ==================== Main ==================== */
int main(void) {
    clock_init_84MHz();
    gpio_init();
    usart2_init_115200();
    usart1_init_9600();
    tim2_ic_init();

    /* Enable RX interrupt on USART1 */
    USART1->CR1 |= USART_CR1_RXNEIE;
    NVIC_SetPriority(USART1_IRQn, 5);
    NVIC_EnableIRQ(USART1_IRQn);

    /* Enable TIM2 CC interrupt */
    NVIC_SetPriority(TIM2_IRQn, 6);
    NVIC_EnableIRQ(TIM2_IRQn);

    /* Start input capture channel 2 */
    TIM2->CCER |= TIM_CCER_CC2E;

    /* FreeRTOS tasks */
    xTaskCreate(UltrasonicTask, "US", 256, NULL, 1, NULL);
    xTaskCreate(BluetoothTask,  "BT", 256, NULL, 2, NULL);

    vTaskStartScheduler();
    while (1) { /* should never get here */ }
}

/* ==================== System clock: 84 MHz from HSI+PLL ==================== */
static void clock_init_84MHz(void) {
    /* Enable HSI */
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY));

    /* PLL = HSI/16 * 336 / 4 = 84 MHz, PLLQ=7 (USB unused) */
    RCC->PLLCFGR = (16u)                         /* PLLM */
                 | (336u << 6)                   /* PLLN */
                 | (0u << 16)                    /* PLLP = /2 -> set to /4 with bits below */
                 | RCC_PLLCFGR_PLLSRC_HSI
                 | (7u << 24);                   /* PLLQ */
    /* PLLP bits: 00->/2, 01->/4, 10->/6, 11->/8; we want /4 */
    RCC->PLLCFGR &= ~(3u << 16);
    RCC->PLLCFGR |=  (1u << 16);                 /* /4 */

    RCC->CR |= RCC_CR_PLLON;
    while (!(RCC->CR & RCC_CR_PLLRDY));

    /* AHB= /1, APB1=/2 (42MHz), APB2=/1 (84MHz) */
    RCC->CFGR = RCC_CFGR_PPRE1_DIV2 | RCC_CFGR_PPRE2_DIV1 | RCC_CFGR_HPRE_DIV1;
    /* Flash wait states 2 */
    FLASH->ACR = FLASH_ACR_ICEN | FLASH_ACR_DCEN | FLASH_ACR_LATENCY_2WS;

    /* Switch SYSCLK to PLL */
    RCC->CFGR &= ~RCC_CFGR_SW;
    RCC->CFGR |= RCC_CFGR_SW_PLL;
    while (((RCC->CFGR >> 2) & 3) != 2);
}

/* ==================== GPIO ==================== */
static void gpio_init(void) {
    /* Clocks */
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;

    /* PA5 LED: output PP */
    GPIOA->MODER &= ~(3u << (5*2));
    GPIOA->MODER |=  (1u << (5*2));
    GPIOA->OTYPER &= ~(1u << 5);
    GPIOA->OSPEEDR |= (2u << (5*2));
    GPIOA->PUPDR   &= ~(3u << (5*2));

    /* PA0: TRIG output */
    GPIOA->MODER &= ~(3u << (0*2));
    GPIOA->MODER |=  (1u << (0*2));  /* output */
    GPIOA->OTYPER &= ~(1u << 0);
    GPIOA->OSPEEDR |= (2u << (0*2));
    GPIOA->PUPDR   &= ~(3u << (0*2));
    GPIOA->BSRR = (uint32_t)(1u << (0 + 16)); /* drive low */

    /* PA1: TIM2_CH2 AF1 */
    GPIOA->MODER &= ~(3u << (1*2));
    GPIOA->MODER |=  (2u << (1*2));          /* AF */
    GPIOA->AFR[0] &= ~(0xF << (1*4));
    GPIOA->AFR[0] |=  (1u << (1*4));         /* AF1 = TIM2 */

    /* PA9 (TX), PA10 (RX) AF7 for USART1 */
    GPIOA->MODER &= ~((3u<<(9*2)) | (3u<<(10*2)));
    GPIOA->MODER |=  ((2u<<(9*2)) | (2u<<(10*2)));
    GPIOA->AFR[1] &= ~((0xF<<((9-8)*4)) | (0xF<<((10-8)*4)));
    GPIOA->AFR[1] |=  ((7u<<((9-8)*4)) | (7u<<((10-8)*4)));
    GPIOA->PUPDR &= ~((3u<<(9*2)) | (3u<<(10*2)));
    GPIOA->PUPDR |=  ((1u<<(10*2)));   /* pull-up on RX */
}

/* ==================== USART1 9600 (APB2=84MHz) ==================== */
static void usart1_init_9600(void) {
    RCC->APB2ENR |= RCC_APB2ENR_USART1EN;

    USART1->CR1 = 0;
    USART1->CR2 = 0;
    USART1->CR3 = 0;

    /* BRR: USARTDIV = 84e6/(16*9600) = 546.875 -> mant=546 (0x222), frac=14 (0xE) => 0x222E */
    USART1->BRR = 0x222E;

    USART1->CR1 |= USART_CR1_TE | USART_CR1_RE | USART_CR1_UE;
}

/* ==================== USART2 115200 (APB1=42MHz) ==================== */
static void usart2_init_115200(void) {
    RCC->APB1ENR |= RCC_APB1ENR_USART2EN;

    /* PA2/PA3 would be default, but on Nucleo LED is PA5; we only TX on USART2 via ST-Link VCP typically using PA2.
       If your board uses different pins, configure AF accordingly. For simplicity assume pins already mapped by BSP.
       If needed, set PA2 AF7 here. */
    /* Minimal setup: 8N1, oversampling 16 */
    USART2->CR1 = 0;
    USART2->CR2 = 0;
    USART2->CR3 = 0;

    /* BRR: 42e6/(16*115200)=22.786 -> mant=22 (0x16), frac≈13 (0xD) => 0x16D */
    USART2->BRR = 0x016D;

    USART2->CR1 |= USART_CR1_TE | USART_CR1_UE;
}

/* ==================== TIM2 CH2 input capture on PA1 ==================== */
static void tim2_ic_init(void) {
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;

    TIM2->PSC = 84-1;        /* 84MHz/84 = 1MHz -> 1us per tick */
    TIM2->ARR = 0xFFFF;

    /* CC2 as input mapped to TI2 */
    TIM2->CCMR1 &= ~(TIM_CCMR1_CC2S | TIM_CCMR1_IC2F | TIM_CCMR1_IC2PSC);
    TIM2->CCMR1 |=  (1u << 8);      /* CC2S=01 -> TI2 */
    /* Rising edge first */
    TIM2->CCER &= ~(TIM_CCER_CC2P | TIM_CCER_CC2NP);

    /* Enable CC2 interrupt */
    TIM2->DIER |= TIM_DIER_CC2IE;

    /* Counter enable */
    TIM2->CR1 |= TIM_CR1_CEN;
}

/* ==================== 10 us trigger using simple cycle delay ==================== */
static inline void delay_us(uint32_t us) {
    /* Using 84MHz core clock -> 84 cycles per us. Simple loop (approx) */
    for (volatile uint32_t i = 0; i < us * 10; ++i) {
        __NOP(); __NOP(); __NOP(); __NOP(); __NOP(); __NOP(); __NOP(); __NOP();
    }
}

static void hc_sr04_trigger(void) {
    GPIOA->BSRR = (1u << 0);          /* PA0 high */
    delay_us(10);
    GPIOA->BSRR = (1u << (0+16));     /* PA0 low */
}

static float hc_sr04_read_cm(void) {
    /* Arm on rising edge, let IRQ measure pulse width */
    ic_first = 0;
    /* Ensure CC2 interrupt enabled and rising edge selected */
    TIM2->CCER &= ~(TIM_CCER_CC2P | TIM_CCER_CC2NP);
    TIM2->DIER |= TIM_DIER_CC2IE;

    hc_sr04_trigger();

    /* Wait ~60 ms for measurement (cooperative) */
    vTaskDelay(pdMS_TO_TICKS(60));
    return g_distance_cm;
}

/* ==================== Command parser ==================== */
static void process_cmd(const char *cmd) {
    if (strcmp(cmd, "led on") == 0) {
        GPIOA->BSRR = (1u << 5);
        usart_write_str(USART1, "LED turned ON\r\n");
    } else if (strcmp(cmd, "led off") == 0) {
        GPIOA->BSRR = (1u << (5+16));
        usart_write_str(USART1, "LED turned OFF\r\n");
    } else {
        usart_write_str(USART1, "Unknown command\r\n");
    }
}

/* ==================== Tasks ==================== */
static void BluetoothTask(void *arg) {
    (void)arg;
    usart_write_str(USART2, "Bluetooth Chat Ready\r\n");
    for (;;) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

static void UltrasonicTask(void *arg) {
    (void)arg;
    for (;;) {
        float d = hc_sr04_read_cm();
        printf("Distance = %.2f cm\r\n", d);
        vTaskDelay(pdMS_TO_TICKS(500));
    }
}

/* ==================== IRQ Handlers ==================== */
void USART1_IRQHandler(void) {
    if (USART1->SR & USART_SR_RXNE) {
        rxByte = (char)(USART1->DR & 0xFF);

        if (rxByte == '\r' || rxByte == '\n') {
            if (rxIndex > 0) {
                rxBuffer[rxIndex] = '\0';
                /* echo to debug */
                usart_write_str(USART2, "Received: ");
                usart_write_str(USART2, (const char*)rxBuffer);
                usart_write_str(USART2, "\r\n");
                process_cmd((const char*)rxBuffer);
                rxIndex = 0;
            }
        } else {
            if (rxIndex < (RX_BUFFER_SIZE-1)) {
                rxBuffer[rxIndex++] = rxByte;
            } else {
                rxIndex = 0; /* overflow protect */
            }
        }
    }
}

void TIM2_IRQHandler(void) {
    if (TIM2->SR & TIM_SR_CC2IF) {
        uint32_t cap = TIM2->CCR2;

        if (!ic_first) {
            ic_val1 = cap;
            ic_first = 1;
            /* Switch to falling edge */
            TIM2->CCER |= TIM_CCER_CC2P;
        } else {
            ic_val2 = cap;
            /* compute pulse width in us (timer @1MHz) */
            if (ic_val2 >= ic_val1) ic_diff = ic_val2 - ic_val1;
            else                    ic_diff = (0xFFFF - ic_val1) + ic_val2;

            /* Distance: time(us) * speed(0.0343 cm/us) / 2 */
            g_distance_cm = (float)ic_diff * 0.0343f * 0.5f;

            /* Re-arm for rising edge next time and (optionally) mask CC2 until next trigger */
            TIM2->CCER &= ~TIM_CCER_CC2P;     /* rising */
            TIM2->DIER &= ~TIM_DIER_CC2IE;    /* will be re-enabled before trigger */
            ic_first = 0;
        }
        TIM2->SR &= ~TIM_SR_CC2IF;
    }
}
