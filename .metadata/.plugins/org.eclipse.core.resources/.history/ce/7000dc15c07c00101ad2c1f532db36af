void sendToPC(const char* str) {
    HAL_UART_Transmit(&huart2, (uint8_t*)str, strlen(str), HAL_MAX_DELAY);
}

void sendToBT(const char* str) {
    HAL_UART_Transmit(&huart1, (uint8_t*)str, strlen(str), HAL_MAX_DELAY);
}

/* UART receive complete callback */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART1) { // Data from HC-05
        if (rxBT == '\r' || rxBT == '\n') {
            bufBT[iBT] = '\0'; // null-terminate
            if (iBT > 0) {
                sendToPC("\r\nFrom Phone: ");
                sendToPC(bufBT);
                sendToPC("\r\n> ");
                iBT = 0;
            }
        } else {
            if (iBT < sizeof(bufBT) - 1) bufBT[iBT++] = rxBT;
        }
        HAL_UART_Receive_IT(&huart1, &rxBT, 1); // restart interrupt
    }
    else if (huart->Instance == USART2) { // Data from PC
        if (rxPC == '\r' || rxPC == '\n') {
            bufPC[iPC] = '\0'; // null-terminate
            if (iPC > 0) {
                sendToBT(bufPC);
                sendToBT("\r\n");
                sendToPC("\r\n> ");
                iPC = 0;
            }
        } else {
            if (iPC < sizeof(bufPC) - 1) bufPC[iPC++] = rxPC;
        }
        HAL_UART_Receive_IT(&huart2, &rxPC, 1); // restart interrupt
    }
}

