/* ---------- helper: send AT command (no blocking receive) ---------- */
static void esp_send(const char *cmd)
{
    HAL_UART_Transmit(&huart2, (uint8_t*)cmd, strlen(cmd), HAL_MAX_DELAY);
}

/* ---------- helper: send AT command and wait for substring ---------- */
static int esp_send_wait(const char *cmd, const char *wait_for, uint32_t timeout_ms)
{
    memset(rx_buf, 0, sizeof(rx_buf));
    esp_send(cmd);

    uint32_t tickstart = HAL_GetTick();
    uint32_t idx = 0;
    uint8_t ch;

    while ((HAL_GetTick() - tickstart) < timeout_ms && idx < sizeof(rx_buf)-1) {
        if (HAL_UART_Receive(&huart2, &ch, 1, 50) == HAL_OK) {
            rx_buf[idx++] = ch;
            rx_buf[idx] = 0;
            if (strstr((char*)rx_buf, wait_for) != NULL) {
                return 0; // found
            }
        }
    }
    return -1; // timeout / not found
}

/* ---------- connect to WiFi ---------- */
static int esp_connect_wifi(void)
{
    // Reset module
    if (esp_send_wait("AT+RST\r\n", "OK", 3000) != 0) {
        // some firmwares reply different; still continue
    }
    HAL_Delay(2000);

    // Set station mode
    if (esp_send_wait("AT+CWMODE=1\r\n", "OK", 2000) != 0) return -1;

    // Join AP
    char cmd[256];
    snprintf(cmd, sizeof(cmd), "AT+CWJAP=\"%s\",\"%s\"\r\n", WIFI_SSID, WIFI_PASS);
    if (esp_send_wait(cmd, "WIFI CONNECTED", 15000) != 0) {
        // Sometimes returns "OK" only; check that too
        if (esp_send_wait(NULL, "OK", 3000) != 0) return -1;
    }
    HAL_Delay(1000);
    return 0;
}

/* ---------- open TCP to server ---------- */
static int esp_tcp_connect(const char *host, uint16_t port)
{
    char cmd[256];
    snprintf(cmd, sizeof(cmd), "AT+CIPSTART=\"TCP\",\"%s\",%u\r\n", host, port);
    if (esp_send_wait(cmd, "CONNECT", 8000) != 0) {
        // Some firmwares reply "OK" + "CONNECT" or "OK" only; accept "OK" followed by "Linked" too
        if (strstr((char*)rx_buf, "ERROR") != NULL) return -1;
        // tolerate if "OK" only but server connection may not be established — still proceed with caution
    }
    return 0;
}

/* ---------- send raw TCP payload (CIPSEND then data) ---------- */
static int esp_tcp_send_data(const char *data, uint32_t len)
{
    char cmd[64];
    snprintf(cmd, sizeof(cmd), "AT+CIPSEND=%u\r\n", (unsigned)len);
    if (esp_send_wait(cmd, ">", 4000) != 0) {
        // some firmware returns "SEND OK" immediately or "OK", check rx_buf
        if (strstr((char*)rx_buf, "ERROR") != NULL) return -1;
    }
    // send payload
    HAL_UART_Transmit(&huart2, (uint8_t*)data, len, HAL_MAX_DELAY);

    // wait for "SEND OK" or for server reply
    if (esp_send_wait(NULL, "SEND OK", 5000) != 0) {
        // not found, but sometimes server replies with HTTP response; attempt to accept
        // read available until timeout
    }
    return 0;
}

/* ---------- close TCP ---------- */
static void esp_tcp_close(void)
{
    esp_send("AT+CIPCLOSE\r\n");
    // ignore response
    HAL_Delay(200);
}

/* ---------- build and post JSON telemetry to ThingsBoard via HTTP ---------- */
static int post_telemetry_http(float temperature, float humidity)
{
    // JSON payload
    char payload[256];
    int payload_len = snprintf(payload, sizeof(payload),
                               "{\"temperature\":%.2f,\"humidity\":%.2f}", temperature, humidity);
    if (payload_len <= 0) return -1;

    // Build HTTP request
    char req[512];
    int req_len = snprintf(req, sizeof(req),
        "POST /api/v1/%s/telemetry HTTP/1.1\r\n"
        "Host: %s\r\n"
        "Content-Type: application/json\r\n"
        "Content-Length: %d\r\n"
        "Connection: close\r\n"
        "\r\n"
        "%s",
        TB_TOKEN,
        TB_HOST,
        payload_len,
        payload);

    if (req_len <= 0) return -1;

    // connect to server
    if (esp_tcp_connect(TB_HOST, TB_PORT) != 0) return -1;

    // send http request
    if (esp_tcp_send_data(req, req_len) != 0) {
        esp_tcp_close();
        return -1;
    }

    // wait for HTTP response (read portion) to rx_buf for debugging
    memset(rx_buf,0,sizeof(rx_buf));
    uint32_t tick = HAL_GetTick();
    uint32_t idx = 0;
    uint8_t ch;
    while ((HAL_GetTick() - tick) < 3000 && idx < sizeof(rx_buf)-1) {
        if (HAL_UART_Receive(&huart2, &ch, 1, 200) == HAL_OK) {
            rx_buf[idx++] = ch;
            rx_buf[idx] = 0;
        } else {
            // no data
        }
    }

    // close connection
    esp_tcp_close();

    // Optionally send response to debug terminal (here we re-transmit the HTTP response back to same UART)
    // But we will print to debug (USART2) so use HAL_UART_Transmit (same UART used to ESP).
    // If you have separate debug UART, transmit there instead.
    // For simplicity we return success if payload was sent.
    return 0;
}

